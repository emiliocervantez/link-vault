<Window x:Class="LinkVault.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Background="White" MaxWidth="720">
    <Window.Resources>
        <SolidColorBrush x:Key="Highlight" Color="#CCE8FF"/>
        <SolidColorBrush x:Key="HighlightBorder" Color="#99D1FF"/>
        <SolidColorBrush x:Key="Disabled" Color="#6D6D6D"/>

        <Style x:Key="RowStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="IsEnabled" Value="{Binding Selectable}"/>
            <Setter Property="FontWeight" Value="{Binding FontWeight}"/>
            <Setter Property="FontSize" Value="{Binding FontSize}"/>
            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter Content="{Binding Content}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Highlight}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter TargetName="Bd" Property="Padding" Value="4,3"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#A0A0A0" BorderThickness="1" Padding="2" Background="White">
        <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Focusable="False"
                 ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PreviewMouseMove="List_PreviewMouseMove"
                 PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"/>
    </Border>
</Window>
